{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@components/*": [
        "components/*"
      ],
      "@constants/*": [
        "constants/*"
      ],
      "@images/*": [
        "images/*"
      ],
      "@app-types/*": [
        "types/*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@validation/*": [
        "validation/*"
      ],
      "@scan/*": [
        "scan/*"
      ],
      "@models/*": [
        "models/*"
      ],
      "@helper/*": [
        "helper/*"
      ],
      "@hooks/*": [
        "hooks/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}